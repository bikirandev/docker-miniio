# =============================================================================
# MinIO on Dokploy - environment variables
#
# Paste into Dokploy (Compose service -> Environment), fill in, and Save.
# For local runs copy to .env (git-ignored). Never commit real secrets.
#
# Generate secrets with:   openssl rand -hex 32
# A value containing "$" must be wrapped in single quotes ('...'), otherwise
# Docker Compose treats it as a variable reference and silently changes it.
# =============================================================================


# --- MinIO -------------------------------------------------------------------

# Root (admin) credentials. REQUIRED - the deploy fails while these are empty.
# Do not use "minioadmin"; pick a non-obvious user name and a long random password.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Public console URL: the domain you route to port 9001 (NOT 9000) in
# Dokploy -> Domains. The API and the console each need their own domain.
MINIO_BROWSER_REDIRECT_URL=https://console.example.com

# "on" sends browsers that open the API domain to MINIO_BROWSER_REDIRECT_URL.
# Keep "off" unless the two domains differ, or the browser loops forever
# ("redirected you too many times").
MINIO_BROWSER_REDIRECT=off

# Public S3 API URL (the domain routed to port 9000). Optional: makes share links
# created in the console use this host. The server must be able to reach this URL
# itself; leave empty if console login fails after setting it.
MINIO_SERVER_URL=

# "off" disables the web console entirely (S3 API only). Most secure option if
# you manage MinIO with the mc CLI instead.
MINIO_BROWSER=on


# --- Scheduled backup to Cloudflare R2 ------------------------------------------

# Master switch for the backup service.
BACKUP_ENABLED=false

# When to run: cron expression (minute hour day-of-month month day-of-week),
# evaluated in TZ. Keep the double quotes. Examples:
#   "0 3 * * *"      every day at 03:00
#   "0 */6 * * *"    every 6 hours
#   "30 2 * * 0"     Sundays at 02:30
#   "@hourly"        every hour
BACKUP_SCHEDULE="0 3 * * *"

# Time zone for BACKUP_SCHEDULE (IANA name, e.g. Asia/Dhaka, Europe/Berlin).
TZ=UTC

# Also run one backup every time the backup container starts (e.g. on deploy).
BACKUP_RUN_ON_STARTUP=false

# sync = mirror MinIO; objects deleted in MinIO are moved to archive/ in R2.
# copy = only add/update; nothing is ever removed from current/ in R2.
# Either way, overwritten objects keep their previous version in archive/.
BACKUP_MODE=sync

# Comma-separated list of buckets to back up. Empty = all buckets.
BACKUP_BUCKETS=

# Days to keep archived (overwritten/deleted) object versions. 0 = keep forever.
BACKUP_RETENTION_DAYS=30

# Cloudflare R2 credentials. Create the bucket first, then an API token:
# R2 -> Manage API tokens -> Create API token -> "Object Read & Write",
# restricted to that one bucket. Account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Folder inside the R2 bucket that holds this server's backups.
R2_PREFIX=minio

# Optional endpoint override. Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# EU jurisdiction buckets: https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Client-side encryption (rclone crypt) before data leaves the server. Strongly
# recommended. Store both values in a password manager: without them the backups
# CANNOT be restored. Never change them once backups exist - use a new R2_PREFIX
# instead. Setting a password turns encryption on; the salt is optional but advised.
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_ENCRYPTION_SALT=

# Least-privilege MinIO credentials for the backup job (see README). Empty = use
# the root credentials above.
BACKUP_MINIO_ACCESS_KEY=
BACKUP_MINIO_SECRET_KEY=

# Optional monitoring: URLs requested (HTTP GET) when a run starts, succeeds or
# fails, e.g. healthchecks.io ("https://hc-ping.com/<uuid>/start", ".../<uuid>",
# ".../<uuid>/fail") or an Uptime Kuma push URL (?status=up / ?status=down).
BACKUP_PING_START_URL=
BACKUP_PING_SUCCESS_URL=
BACKUP_PING_FAILURE_URL=

# Extra rclone flags for tuning, e.g. "--transfers 8 --bwlimit 20M --fast-list".
BACKUP_RCLONE_FLAGS=
